    "UserPublic": {
      "title": "UserPublic",
      "description": "Public user profile, presence, badges, and invite code metrics without PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "username": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "pattern": "^[a-z0-9_]+$"
        },
        "photoURL": {
          "type": "string",
          "maxLength": 250000
        },
        "bio": {
          "type": "string",
          "maxLength": 240
        },
        "language": {
          "type": "string",
          "enum": ["ar", "en"]
        },
        "isOnline": {
          "type": "boolean"
        },
        "lastSeen": {
          "type": "string",
          "format": "date-time"
        },
        "activeChatId": {
          "type": "string",
          "maxLength": 128
        },
        "isAdmin": {
          "type": "boolean"
        },
        "isVerified": {
          "type": "boolean"
        },
        "inviteCode": {
          "type": "string",
          "maxLength": 16
        },
        "invitedBy": {
          "type": "string",
          "maxLength": 128
        },
        "inviteCount": {
          "type": "integer"
        },
        "isVip": {
          "type": "boolean"
        },
        "isBanned": {
          "type": "boolean"
        },
        "mutedUntil": {
          "type": "string",
          "format": "date-time"
        },
        "isBot": { "type": "boolean" },
        "isPlus": { "type": "boolean" },
        "hasPhone": { "type": "boolean" },
        "privacyPhone": { "type": "string", "enum": ["everyone", "contacts", "nobody"] },
        "privacyLastSeen": { "type": "string", "enum": ["everyone", "contacts", "nobody"] },
        "privacyLastSeenExceptions": { "type": "array" },
        "privacyProfilePhoto": { "type": "string", "enum": ["everyone", "contacts", "nobody"] },
        "privacyGroupAdd": { "type": "string", "enum": ["everyone", "contacts"] },
